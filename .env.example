# Server only. Never prefix credentials with VITE_.
GROQ_API_KEY=
# The previous Llama 3.3 model was retired by Groq on August 16, 2026.
# GPT-OSS 120B supports Groq's free plan; your account's quotas still apply.
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_STRUCTURED_MODEL=openai/gpt-oss-120b
AI_REQUESTS_PER_HOUR=60
AI_GLOBAL_REQUESTS_PER_HOUR=600

# Generate each separately: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
SESSION_SECRET=
# Exact public origin without a trailing slash. Required in production.
# For development, leave blank to use the current localhost origin.
APP_ORIGIN=
DATABASE_PATH=./data/mindforge.sqlite

# Direct Google OAuth. Redirect URI: <APP_ORIGIN>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional SMTP for password recovery. Email/password sign-in needs no SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Use false only for a local test mail server. Port 465 uses implicit TLS.
SMTP_REQUIRE_TLS=true

# Optional shared AI limits. SQLite accounts require one server with a persistent disk.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NITRO_PRESET=node-server
