# Only backend environment variables. Never prefix secrets with VITE_.
# Supabase Dashboard > Connect > Session pooler (IPv4, port 5432).
# Replace the password placeholder with a URL-encoded database password.
DATABASE_URL=
FRONTEND_ORIGIN=http://127.0.0.1:3001
PORT=4000
# Generate each separately: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
SESSION_SECRET=
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_STRUCTURED_MODEL=openai/gpt-oss-120b
AI_REQUESTS_PER_HOUR=60
AI_GLOBAL_REQUESTS_PER_HOUR=600
PG_POOL_MAX=3
# Google Console callback: <FRONTEND_ORIGIN>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# HTTPS email delivery for password recovery; Render Free blocks SMTP.
RESEND_API_KEY=
MAIL_FROM=
